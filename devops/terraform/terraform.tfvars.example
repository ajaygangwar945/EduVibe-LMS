# Example configuration variables for AWS deployment
# Copy or rename this file to 'terraform.tfvars' to customize values:

aws_region        = "ap-south-1"     # Mumbai (ap-south-1), us-east-1, etc.
project_name      = "eduvibe"
environment       = "prod"
instance_type     = "t2.micro"       # Free Tier eligible (750 hours/month free)
admin_cidr_blocks = ["0.0.0.0/0"]   # Set to ["YOUR_IP/32"] to restrict SSH/Grafana/Prometheus
