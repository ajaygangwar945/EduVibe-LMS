# =============================================================================
# EduVibe LMS - Centralized Environment Configuration Template
# Copy this file to .env and configure with your credentials
# =============================================================================

# MongoDB Atlas Cloud Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.0xjeu.mongodb.net/eduvibe?appName=Cluster0

# Backend API Configuration
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_EMAIL=admin@eduvibe.com
ADMIN_PASSWORD=your_secure_admin_password

# Resend Transactional Email API for 6-Digit OTP Delivery
RESEND_API_KEY=re_your_resend_api_key_here

# Vite Frontend & Vercel API Base URL
VITE_API_BASE_URL=http://localhost:5000

# Optional Local DevOps Viewer Tools
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=your_secure_password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password
